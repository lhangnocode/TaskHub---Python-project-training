# Application Environment Settings
PROJECT_NAME="TaskHub API"
DEBUG=True
SECRET_KEY="super-secret-jwt-key-change-this-in-production-taskhub-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskhub

DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/taskhub"

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_TTL_SECONDS=300

# FastAPI-Mail Configuration
MAIL_USERNAME="noreply@taskhub.com"
MAIL_PASSWORD="secretpassword"
MAIL_FROM="noreply@taskhub.com"
MAIL_PORT=1025
MAIL_SERVER="localhost"
MAIL_FROM_NAME="TaskHub Notifications"
MAIL_STARTTLS=False
MAIL_SSL_TLS=False
USE_CREDENTIALS=False
VALIDATE_CERTS=False
SUPPRESS_SEND=1
